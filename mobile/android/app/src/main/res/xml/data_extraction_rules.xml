<?xml version="1.0" encoding="utf-8"?>
<!-- StepAway keeps pairing secrets under a device-bound Keystore key; a cloud backup or a
     device-to-device copy would be useless and would put data off the device. Exclude all. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
